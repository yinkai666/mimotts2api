# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Secret (至少 32 字符，必需)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Admin Account（首次初始化数据库时使用；数据库已有用户后不会覆盖现有密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# MiMo API Configuration（可选，也可以通过前端设置页面填写）
# 如果在这里设置，将作为默认值；前端设置页面中的值会覆盖此处的值
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_API_KEY=sk-your-mimo-api-key

# Proxy Auth Token（可选，不填则 /v1/audio/speech 不需要鉴权）
# 如果需要保护 API 接口不被未授权调用，请设置一个 Token
# PROXY_AUTH_TOKEN=your_proxy_auth_token_here

# Upload Configuration
MAX_UPLOAD_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Server Port (default: 14678)
# 使用高位端口避免与其他服务冲突
PORT=14678
